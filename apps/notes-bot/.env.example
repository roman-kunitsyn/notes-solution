# Required: Telegram bot token.
TELEGRAM_BOT_TOKEN=
# Required: Supabase API URL. Safe local-development example.
SUPABASE_URL=http://127.0.0.1:54321
# Required: Supabase publishable or legacy anonymous key; never use a secret key.
SUPABASE_PUBLISHABLE_KEY=
# Required: public browser-linking base URL. HTTP is allowed only for localhost.
NOTES_BOT_BASE_URL=http://127.0.0.1:8080
# Required: URL-safe base64 encoding of exactly 32 bytes.
NOTES_BOT_ENCRYPTION_KEY=
# Optional: SQLite database path; defaults to the platform data directory.
NOTES_BOT_DATABASE_PATH=
# Optional: safe local bind host.
NOTES_BOT_HTTP_HOST=127.0.0.1
# Optional: safe local HTTP port.
NOTES_BOT_HTTP_PORT=8080
